DB_URL=jdbc:postgresql://localhost:5432/factoryflow
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=PT15M
PARSER_FUZZY_THRESHOLD=0.82
REPORT_STORAGE_ROOT=./data/generated-reports
