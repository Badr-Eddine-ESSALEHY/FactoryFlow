MAIL_USERNAME=replace-with-test-or-company-sender
MAIL_PASSWORD=replace-with-local-app-password
MAIL_FROM=replace-with-test-or-company-sender
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
